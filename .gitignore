.ycode/
# 会话计划快照（运行时状态，不入库）
.zcode/

# Scraped / downloaded HTML files（仅忽略仓库根目录下的抓取/临时网页；
# /* 限定层级，避免误伤 frontend/index.html 这类项目源码里的 HTML 模板）
/*.html
!frontend/index.html

