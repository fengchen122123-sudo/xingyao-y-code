# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.env
.venv
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# PyInstaller (auto-generated, never commit)
# 注意：ycode.spec / ycode_setup.spec / ycode_uninstall.spec 是项目自定义配置，
# 已纳入版本控制；其他自动生成的 .spec（例如 build_release.py 用 --onefile
# 动态构建 ycode_setup.exe / ycode_tui_setup.exe 时，PyInstaller 在临时目录
# 里自动生成的那些）仍然忽略。
*.spec
!ycode.spec
!ycode_setup.spec
!ycode_uninstall.spec

# pytest
.pytest_cache/
mytemp/

# SQLite databases (contain user data / dev state)
*.db

# Per-session persisted task plans (runtime state)
.ycode_tasks/plans/*.json
.ycode_tasks/plans/*.tmp

# Scraped / downloaded HTML files（仅忽略仓库根目录下的抓取/临时网页；
# /* 限定层级，避免误伤 frontend/index.html 这类项目源码里的 HTML 模板）
/*.html
!frontend/index.html

# IDE
.idea/
.vscode/
*.swp
*.swo

# Project secrets & local state (NEVER commit real API keys)
config.json
active_skills.json
mcp.json

# OS
.DS_Store
Thumbs.db

# Scratch and temporary files
scratch_*
scratch/
generate_interview_pdf*.py
zip/
*.pdf

# DB debug exports (temporary debug dumps)
db_*.txt

# Temporary test directories
test20*/
.workbuddy/
