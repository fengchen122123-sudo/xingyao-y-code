{
  "active_model_id": "model_1",
  "permission_mode": "confirm",
  "allow_outside_workspace": false,
  "command_shell": "auto",
  "secondary_model_id": null,
  "secondary_model_roles": {
    "vision": true,
    "compression": true,
    "subagent": true
  },
  "image_compression": {
    "max_edge": 1536,
    "quality": 90,
    "max_output_bytes": 1048576
  },
  "search_exclude_dirs": ["target", "out", "bin", "obj"],
  "prompt_cache_keepalive_seconds": 0,
  "route_request_overrides": [
    {
      "match": "gateway.example.com",
      "headers": {
        "X-Example-Agent": "XingYaoCode/0.0.0"
      },
      "body": {
        "thinking": { "type": "enabled" }
      }
    }
  ],
  "memory_compression": {
    "retain_count": 8,
    "retain_count_force": 4,
    "tool_result_truncate_threshold_chars": 2000,
    "tool_result_preview_limit_chars": 800,
    "tool_result_token_limit": 600,
    "summary_length_first": 250,
    "summary_length_merge": 350,
    "inter_chunk_delay_seconds": 0,
    "precompress_ratio": 0.85
  },
  "resume": {
    "enabled": false
  },
  "providers": [
    {
      "id": "provider_1",
      "name": "Agnes AI",
      "base_url": "https://apihub.agnes-ai.cn/v1",
      "api_key": "sk-your-agnes-api-key-here",
      "protocol": "openai",
      "models": [
        {
          "id": "model_1",
          "name": "agnes-3.0-flash",
          "litellm_model": "openai/agnes-3.0-flash",
          "context_window": 512000,
          "supports_vision": true,
          "supports_function_calling": true,
          "max_tokens": 65535,
          "thinking_budget": null,
          "enable_thinking": null,
          "reasoning_effort": null
        },
        {
          "id": "model_2",
          "name": "agnes-2.5-flash",
          "litellm_model": "openai/agnes-2.5-flash",
          "context_window": 128000,
          "supports_vision": true,
          "max_tokens": 8192,
          "thinking_budget": null,
          "enable_thinking": null,
          "reasoning_effort": null
        }
      ]
    },
    {
      "id": "provider_deepseek",
      "name": "深度求索",
      "base_url": "https://api.deepseek.com",
      "api_key": "sk-your-deepseek-api-key-here",
      "protocol": "openai",
      "preset_id": "deepseek",
      "models": [
        {
          "id": "deepseek_v4_pro",
          "name": "deepseek-v4-pro",
          "litellm_model": "openai/deepseek-v4-pro",
          "context_window": 1000000,
          "supports_vision": false,
          "max_tokens": 8192,
          "enable_thinking": true,
          "reasoning_effort": "max"
        },
        {
          "id": "deepseek_flash",
          "name": "deepseek-flash",
          "litellm_model": "openai/deepseek-flash",
          "context_window": 1000000,
          "supports_vision": false,
          "max_tokens": 8192,
          "enable_thinking": true,
          "reasoning_effort": "max"
        }
      ]
    }
  ]
}
