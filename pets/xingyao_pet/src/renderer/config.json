{
  "version": 3,
  "language": "zh",
  "canvas": {
    "width": 256,
    "height": 256,
    "scale": 0.5
  },
  "anchor": "feet-center",
  "animations": {
    "idle": {
      "fps": 1,
      "loop": true,
      "priority": 0,
      "still": true
    },
    "walk": {
      "fps": 5,
      "loop": true,
      "priority": 1,
      "moveSpeed": 42
    },
    "drag": {
      "fps": 3,
      "loop": true,
      "priority": 2
    },
    "drop": {
      "fps": 4,
      "loop": false,
      "priority": 3,
      "next": "idle",
      "still": true,
      "holdMs": 420
    },
    "sleep": {
      "fps": 1,
      "loop": true,
      "priority": -1,
      "still": true
    },
    "greet": {
      "fps": 4,
      "loop": false,
      "priority": 4,
      "next": "idle"
    },
    "interact": {
      "fps": 4,
      "loop": false,
      "priority": 4,
      "next": "idle"
    }
  },
  "motion": {
    "breathPx": 2,
    "breathSec": 4.2,
    "bounceCheckMs": 150,
    "frameBlend": false
  },
  "bubble": {
    "enabled": true,
    "showMs": 2200
  },
  "behaviors": {
    "idleTimeoutSec": 180,
    "idleBubbleSec": 26,
    "sleepAutoWakeSec": 30,
    "walkProbPerMinute": 0.1,
    "screenEdge": "bounce",
    "persist": {
      "position": true,
      "size": true,
      "settings": true
    }
  }
}
