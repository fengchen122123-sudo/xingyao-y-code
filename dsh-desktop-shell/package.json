{
  "name": "dsh-desktop-shell",
  "version": "0.1.0",
  "description": "Opens the DeepSeek Harness Web GUI in a native WebView2 desktop window when the web profile boots, instead of a browser page",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "types": "./client-dist/types/index.d.ts",
      "default": "./client-dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "shell",
    "client",
    "client-dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.0.0",
    "jsdom": "^30.0.1",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "^0.11.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "build:client": "tsdown && tsc -p tsconfig.json"
  }
}
