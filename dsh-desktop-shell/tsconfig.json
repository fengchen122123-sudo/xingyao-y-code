{
	"compilerOptions": {
		"jsx": "react-jsx",
		"module": "ESNext",
		"target": "ES2020",
		"moduleResolution": "bundler",
		"strict": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"declarationDir": "./client-dist/types",
		"outDir": "./client-dist",
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["client/**/*"],
	"exclude": ["client/**/*.test.tsx", "client/**/*.test.ts"]
}
